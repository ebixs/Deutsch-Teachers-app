{
  "name": "deutsch-teachers-app",
  "productName": "Deutsch-Teachers-app",
  "version": "1.0.0",
  "description": "Deutsch-Teachers-app — Language Teacher Management",
  "author": "Ebrahim",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ebrahim.deutschteachersapp",
    "productName": "Deutsch-Teachers-app",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app-config.json", "renderer/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deutsch-Teachers-app",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Deutsch-Teachers-app_Setup.exe"
    },
    "portable": { "artifactName": "Deutsch-Teachers-app_Portable.exe" }
  }
}
